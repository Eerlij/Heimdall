# Local development values only. Copy to infra/.env (gitignored) and never commit real secrets.
POSTGRES_PASSWORD=change-me-dev-only
HEIMDALL_DB_PASSWORD=change-me-dev-only
KEYCLOAK_DB_PASSWORD=change-me-dev-only

# Optional: PEM of a TLS-intercepting proxy/antivirus root CA, trusted only during image builds.
# Copy the PEM into infra/certs/ (gitignored; Compose only reads secrets inside the project), e.g. for AVG:
#   cp C:/ProgramData/AVG/Antivirus/wscert.pem infra/certs/local-ca.pem
# EXTRA_CA_CERT_FILE=./certs/local-ca.pem
