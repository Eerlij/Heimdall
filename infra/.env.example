# Local development values only. Copy to infra/.env (gitignored) and never commit real secrets.
POSTGRES_PASSWORD=change-me-dev-only
HEIMDALL_DB_PASSWORD=change-me-dev-only
KEYCLOAK_DB_PASSWORD=change-me-dev-only

# Optional: PEM of a TLS-intercepting proxy/antivirus root CA, trusted only during image builds.
# Copy the PEM into infra/certs/ (gitignored; Compose only reads secrets inside the project), e.g. for AVG:
#   cp C:/ProgramData/AVG/Antivirus/wscert.pem infra/certs/local-ca.pem
# EXTRA_CA_CERT_FILE=./certs/local-ca.pem

# Keycloak bootstrap admin (master-realm console at /auth/admin).
KEYCLOAK_ADMIN_PASSWORD=change-me-dev-only

# Confidential OIDC client secret shared by Keycloak (realm import) and the backend (BFF).
HEIMDALL_KEYCLOAK_CLIENT_SECRET=change-me-dev-only

# Browser-facing origin (nginx). Drives the Keycloak hostname, redirect URIs and the issuer.
PUBLIC_ORIGIN=http://localhost

# Realm toggle, re-applied by keycloak-config on every `up`/`run`.
KC_REGISTRATION_ALLOWED=true

# Session cookie Secure flag: false only for plain-http local dev.
HEIMDALL_COOKIE_SECURE=false

# Where nginx forwards /api, /oauth2, /login, /logout (backend runs on the host in dev).
BACKEND_UPSTREAM=host.docker.internal:8080

# Keycloak -> backend back-channel logout URL. Dev-only value; plan 7 sets the `full`/`tunnel` value.
BACKCHANNEL_LOGOUT_URL=http://host.docker.internal:8080/logout/connect/back-channel/keycloak
